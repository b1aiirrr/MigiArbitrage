# ═══════════════════════════════════════════════
# MigiArbitrage — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️ ALERT-ONLY MODE — No trades will be executed.
# All API keys should be READ-ONLY.
# ═══════════════════════════════════════════════

# ── Telegram Bot (Required for alerts) ────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Binance (Read-Only API Key) ──────────────
# Create at: https://www.binance.com/en/my/settings/api-management
# ⚠️ Enable ONLY "Enable Reading" — disable ALL trading permissions
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Kraken (Read-Only API Key) ───────────────
# Create at: https://www.kraken.com/u/security/api
# ⚠️ Enable ONLY "Query Funds" permission
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ── KuCoin (Read-Only API Key) ───────────────
# Create at: https://www.kucoin.com/account/api
# ⚠️ Enable ONLY "General" permission — no trading
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_API_SECRET=your_kucoin_api_secret_here
KUCOIN_API_PASSPHRASE=your_kucoin_passphrase_here

# ── Scanner Configuration ────────────────────
# Minimum net profit (USD) to trigger an alert
MIN_NET_PROFIT_USD=1.00
# Scan interval in milliseconds
SCAN_INTERVAL_MS=500

# ── WebSocket Server (Backend → Frontend) ────
WS_SERVER_HOST=0.0.0.0
WS_SERVER_PORT=8765

# ── Frontend (set in Vercel dashboard) ───────
# URL of your backend WebSocket server
NEXT_PUBLIC_WS_URL=ws://your_server_ip:8765
